{
  "name": "@sandsoftwaresolutions/i18n-check",
  "version": "0.1.1",
  "description": "Compare translation files: missing and extra keys, different placeholders, empty texts. Understands ICU plurals and rich text tags.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE",
    "bin"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test && node scripts/build-cjs.mjs --check",
    "pack:check": "npm pack --dry-run",
    "build": "node scripts/build-cjs.mjs",
    "prepack": "node scripts/build-cjs.mjs"
  },
  "keywords": [
    "i18n",
    "translations",
    "next-intl",
    "icu",
    "lint"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandSoftwareSolutions/ss-i18n-check.git"
  },
  "bugs": {
    "url": "https://github.com/SandSoftwareSolutions/ss-i18n-check/issues"
  },
  "homepage": "https://github.com/SandSoftwareSolutions/ss-i18n-check#readme",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "i18n-check": "./bin/i18n-check.js"
  }
}
